# Where Claude Code keeps its data (default ~/.claude)
CLAUDE_HOME=~/.claude
HOST=127.0.0.1
PORT=4477
# Rescan interval in ms
REFRESH_MS=5000
# A session counts as active if its transcript changed within this many minutes
ACTIVE_WINDOW_MIN=10
# Idle seconds before an outstanding tool call is flagged as a possible wait
WAIT_IDLE_SEC=45
